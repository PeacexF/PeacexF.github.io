---
import "../styles/global.css";

interface Props {
  title: string;
  description?: string;
  path?: string;
}

const {
  title,
  description = "Backend and infrastructure engineer. Systems designed from scratch, with real architecture behind them.",
  path = "",
} = Astro.props;

const segments = path.split("/").filter(Boolean);
const crumbs = segments.map((seg, i) => ({
  label: seg,
  href: "/" + segments.slice(0, i + 1).join("/"),
}));

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const pageTitle = `${title} — Peace`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="google-site-verification" content="FTRL7caHTKY9N8kQQNkPtxQYtpbcOiDBDHR1uvpWmb0" />
    <meta name="theme-color" content="#f6f7f9" />

    <!-- Resolves the theme before the first paint. Inline and blocking on
         purpose: deferring it means a flash of the wrong palette. -->
    <script is:inline>
      (function () {
        var stored = null;
        try {
          stored = localStorage.getItem("theme");
        } catch (e) {
          /* private mode, or storage disabled */
        }
        var theme =
          stored === "light" || stored === "dark"
            ? stored
            : window.matchMedia("(prefers-color-scheme: dark)").matches
              ? "dark"
              : "light";
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Peace" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=IBM+Plex+Sans:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD -->
    <script type="application/ld+json" set:html={JSON.stringify({
      "@context": "https://schema.org",
      "@type": "Person",
      "name": "Peace",
      "url": Astro.site?.toString(),
      "jobTitle": "Backend & Infrastructure Engineer",
      "description": "Backend and infrastructure engineer working on distributed systems, automation, and OSINT tooling.",
      "sameAs": ["https://github.com/PeacexF"],
      "knowsAbout": [
        "Backend Development",
        "Distributed Systems",
        "Infrastructure",
        "DevOps",
        "OSINT",
      ],
    })} />
  </head>
  <body class="min-h-screen flex flex-col">
    <header class="border-b border-hairline">
      <div class="max-w-5xl mx-auto px-6 py-4 flex flex-wrap items-center justify-between gap-x-6 gap-y-2">
        <a href="/" class="font-display font-semibold text-lg tracking-tight text-ink shrink-0">
          Peace
        </a>
        <nav class="flex flex-wrap items-center gap-x-3 gap-y-1 sm:gap-x-6 font-mono text-xs sm:text-sm text-muted">
          <a href="/about" class="hover:text-ink transition-colors">about</a>
          <a href="/services" class="hover:text-ink transition-colors">services</a>
          <a href="/development" class="hover:text-ink transition-colors">development</a>
          <a href="/osint" class="hover:text-ink transition-colors">osint</a>
          <button
            id="theme-toggle"
            type="button"
            class="ml-1 -my-1 p-1.5 rounded-md text-muted hover:text-ink transition-colors cursor-pointer"
            aria-label="Switch to dark theme"
            title="Switch theme"
          >
            <!-- Moon in light mode, sun in dark: the icon shows where you land. -->
            <svg
              class="w-4 h-4 dark:hidden"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
            </svg>
            <svg
              class="w-4 h-4 hidden dark:block"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4"></circle>
              <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"></path>
            </svg>
          </button>
        </nav>
      </div>
      {crumbs.length > 0 && (
        <div class="max-w-5xl mx-auto px-6 pb-3 -mt-1">
          <p class="font-mono text-xs text-muted overflow-x-auto whitespace-nowrap">
            <a href="/" class="hover:text-accent transition-colors">~</a>
            {crumbs.map((c) => (
              <>
                <span class="mx-1 text-hairline">/</span>
                <a href={c.href} class="hover:text-accent transition-colors">{c.label}</a>
              </>
            ))}
          </p>
        </div>
      )}
    </header>

    <main class="flex-1">
      <slot />
    </main>

    <footer class="border-t border-hairline mt-24">
      <div class="max-w-5xl mx-auto px-6 py-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-3 font-mono text-xs text-muted">
        <p>~/peace — backend &amp; infrastructure engineer</p>
        <a href="/about/contact" class="hover:text-accent transition-colors">get in touch →</a>
      </div>
    </footer>

    <script is:inline>
      (function () {
        var root = document.documentElement;
        var button = document.getElementById("theme-toggle");
        var meta = document.querySelector('meta[name="theme-color"]');
        var GROUND = { light: "#f6f7f9", dark: "#0f1319" };

        function apply(theme) {
          root.dataset.theme = theme;
          if (meta) meta.setAttribute("content", GROUND[theme]);
          if (button) {
            button.setAttribute(
              "aria-label",
              theme === "dark" ? "Switch to light theme" : "Switch to dark theme",
            );
          }
          // Mermaid re-renders its diagrams against the new palette.
          document.dispatchEvent(new CustomEvent("themechange", { detail: { theme: theme } }));
        }

        apply(root.dataset.theme === "dark" ? "dark" : "light");

        if (button) {
          button.addEventListener("click", function () {
            var next = root.dataset.theme === "dark" ? "light" : "dark";
            try {
              localStorage.setItem("theme", next);
            } catch (e) {
              /* the choice just will not survive the tab */
            }
            apply(next);
          });
        }

        // Follow the system only while the visitor has not chosen for themselves.
        window
          .matchMedia("(prefers-color-scheme: dark)")
          .addEventListener("change", function (event) {
            var stored = null;
            try {
              stored = localStorage.getItem("theme");
            } catch (e) {
              /* ignore */
            }
            if (stored !== "light" && stored !== "dark") {
              apply(event.matches ? "dark" : "light");
            }
          });
      })();
    </script>
  </body>
</html>