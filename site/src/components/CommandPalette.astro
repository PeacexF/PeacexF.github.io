---
import { buildSiteGraph } from "../lib/site_graph";

// Titles and one-liners only — no coordinates. Small enough to inline on every
// page, which is what makes the palette answer instantly and still work in dev,
// where no Pagefind index exists.
const graph = await buildSiteGraph();
const pages = graph.nodes
  .filter((n) => n.href !== "/")
  .map((n) => ({ label: n.label, href: n.href, section: n.section, hint: n.oneLiner }))
  .sort((a, b) => a.href.localeCompare(b.href));
---

<button
  id="palette-open"
  type="button"
  class="inline-flex items-center gap-2 rounded-md border border-hairline px-2 py-1 font-mono text-xs text-muted transition-colors hover:border-accent hover:text-accent"
  aria-label="Search this site"
>
  search
  <kbd class="hidden sm:inline text-[10px] opacity-70">⌘K</kbd>
</button>

<dialog id="palette" aria-label="Search this site" class="palette">
  <div class="flex items-center gap-2 border-b border-hairline px-4">
    <span class="font-mono text-sm text-accent">/</span>
    <input
      id="palette-input"
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder="Search pages and content…"
      class="w-full bg-transparent py-3 text-sm text-ink outline-none placeholder:text-muted"
    />
    <kbd class="font-mono text-[10px] text-muted">esc</kbd>
  </div>

  <div id="palette-results" class="max-h-[60vh] overflow-y-auto p-2" role="listbox"></div>

  <p
    id="palette-note"
    hidden
    class="border-t border-hairline px-4 py-2 font-mono text-[11px] text-muted"
  >
    Full-text search needs a production build; showing page titles only.
  </p>
</dialog>

<script is:inline type="application/json" id="palette-pages" set:html={JSON.stringify(pages)} />

<style>
  .palette {
    width: min(40rem, calc(100vw - 2rem));
    padding: 0;
    border: 1px solid var(--color-hairline);
    border-radius: 0.6rem;
    background: var(--color-surface);
    color: var(--color-ink);
    /* Longhand: a bare `margin-top` overrides <dialog>'s `margin: auto` and
       drops it against the left edge. */
    margin: 12vh auto auto;
  }

  /* Fixed black, not a token: a scrim has to darken in both themes, and
     --color-ink is near-white in dark mode. */
  .palette::backdrop {
    background: rgb(0 0 0 / 0.5);
    backdrop-filter: blur(2px);
  }

  .palette :global(.hit) {
    display: block;
    border-radius: 0.35rem;
    padding: 0.5rem 0.65rem;
    text-decoration: none;
  }

  .palette :global(.hit[aria-selected="true"]) {
    background: var(--color-paper);
  }

  .palette :global(.hit mark) {
    background: var(--color-accent-soft);
    color: var(--color-ink);
    border-radius: 2px;
  }

  .palette :global(.hit-title) {
    color: var(--color-ink);
    font-weight: 600;
    font-size: 0.875rem;
  }

  .palette :global(.hit-path) {
    color: var(--color-accent);
    font-family: var(--font-mono);
    font-size: 0.6875rem;
  }

  .palette :global(.hit-hint) {
    color: var(--color-muted);
    font-size: 0.75rem;
    line-height: 1.4;
    margin-top: 0.1rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .palette :global(.hit-group) {
    padding: 0.35rem 0.65rem 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.625rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }
</style>

<script>
  interface Page {
    label: string;
    href: string;
    section: string;
    hint: string;
  }
  interface Hit {
    title: string;
    href: string;
    hint: string;
    /** hint may contain Pagefind's <mark> tags, which are safe to render. */
    rich?: boolean;
  }

  const dialog = document.getElementById("palette") as HTMLDialogElement | null;
  const openBtn = document.getElementById("palette-open");
  const input = document.getElementById("palette-input") as HTMLInputElement | null;
  const list = document.getElementById("palette-results");
  const note = document.getElementById("palette-note");
  const pages: Page[] = JSON.parse(
    document.getElementById("palette-pages")?.textContent ?? "[]",
  );

  if (dialog && openBtn && input && list) {
    let selected = 0;
    let hits: Hit[] = [];
    let token = 0;

    type PagefindModule = {
      search(q: string): Promise<{ results: Array<{ data(): Promise<PagefindData> }> }>;
    };
    type PagefindData = { url: string; meta?: { title?: string }; excerpt?: string };

    let pagefind: PagefindModule | null | undefined;

    async function loadPagefind(): Promise<PagefindModule | null> {
      if (pagefind !== undefined) return pagefind;
      try {
        // Built by the `pagefind` CLI after `astro build`, so it does not exist
        // during dev. Held in a variable so neither Vite nor tsc tries to
        // resolve it at build time.
        const specifier = "/pagefind/pagefind.js";
        pagefind = (await import(/* @vite-ignore */ specifier)) as PagefindModule;
      } catch {
        pagefind = null;
      }
      if (note) note.hidden = pagefind !== null;
      return pagefind;
    }

    // Pagefind returns built paths; the rest of the site links without a
    // trailing slash, and a mismatch would duplicate hits.
    function normalise(url: string): string {
      const path = url.replace(/index\.html$/, "").replace(/\.html$/, "");
      return path.length > 1 ? path.replace(/\/$/, "") : path;
    }

    const escape = (s: string) =>
      s.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");

    function titleMatches(query: string): Hit[] {
      const q = query.toLowerCase();
      return pages
        .filter((p) => p.label.toLowerCase().includes(q) || p.href.toLowerCase().includes(q))
        .slice(0, 6)
        .map((p) => ({ title: p.label, href: p.href, hint: p.hint }));
    }

    function render() {
      if (hits.length === 0) {
        list!.innerHTML = `<p class="hit-group">no matches</p>`;
        return;
      }
      list!.innerHTML = hits
        .map(
          (h, i) => `
            <a class="hit" href="${h.href}" role="option" aria-selected="${i === selected}">
              <span class="hit-path">${escape(h.href)}</span>
              <span class="hit-title" style="display:block">${escape(h.title)}</span>
              ${h.hint ? `<span class="hit-hint">${h.rich ? h.hint : escape(h.hint)}</span>` : ""}
            </a>`,
        )
        .join("");
      list!.querySelector('[aria-selected="true"]')?.scrollIntoView({ block: "nearest" });
    }

    function showDefault() {
      hits = pages
        .filter((p) => p.href.split("/").length <= 3)
        .slice(0, 8)
        .map((p) => ({ title: p.label, href: p.href, hint: p.hint }));
      selected = 0;
      render();
    }

    async function run(query: string) {
      const mine = ++token;
      if (!query.trim()) {
        showDefault();
        return;
      }

      // Titles first — they resolve instantly and are usually what is wanted.
      hits = titleMatches(query);
      selected = 0;
      render();

      const pf = await loadPagefind();
      if (!pf || mine !== token) return;

      const search = await pf.search(query);
      if (mine !== token) return;

      const seen = new Set(hits.map((h) => h.href));
      const extra: Hit[] = [];
      for (const r of search.results.slice(0, 8)) {
        const data = await r.data();
        const href = normalise(data.url);
        if (seen.has(href)) continue;
        seen.add(href);
        extra.push({
          title: data.meta?.title ?? href,
          href,
          hint: data.excerpt ?? "",
          rich: true,
        });
      }
      if (mine !== token) return;
      hits = [...hits, ...extra];
      render();
    }

    function open() {
      if (dialog!.open) return;
      dialog!.showModal();
      input!.value = "";
      showDefault();
      input!.focus();
    }

    openBtn.addEventListener("click", open);

    document.addEventListener("keydown", (ev) => {
      const target = ev.target as HTMLElement | null;
      const typing =
        target &&
        (target.tagName === "INPUT" ||
          target.tagName === "TEXTAREA" ||
          target.isContentEditable);

      if ((ev.metaKey || ev.ctrlKey) && ev.key.toLowerCase() === "k") {
        ev.preventDefault();
        open();
      } else if (ev.key === "/" && !typing && !dialog!.open) {
        ev.preventDefault();
        open();
      }
    });

    let debounce = 0;
    input.addEventListener("input", () => {
      clearTimeout(debounce);
      const q = input.value;
      debounce = window.setTimeout(() => void run(q), 120);
    });

    dialog.addEventListener("keydown", (ev) => {
      if (ev.key === "ArrowDown" || ev.key === "ArrowUp") {
        ev.preventDefault();
        if (hits.length === 0) return;
        selected = (selected + (ev.key === "ArrowDown" ? 1 : -1) + hits.length) % hits.length;
        render();
      } else if (ev.key === "Enter") {
        ev.preventDefault();
        const hit = hits[selected];
        if (hit) window.location.href = hit.href;
      }
    });

    // Clicking the backdrop closes; <dialog> reports those clicks as landing on
    // the dialog itself rather than on any child.
    dialog.addEventListener("click", (ev) => {
      if (ev.target === dialog) dialog.close();
    });

    list.addEventListener("mousemove", (ev) => {
      const hit = (ev.target as HTMLElement).closest(".hit");
      if (!hit) return;
      const next = [...list.querySelectorAll(".hit")].indexOf(hit);
      if (next !== -1 && next !== selected) {
        selected = next;
        render();
      }
    });
  }
</script>
