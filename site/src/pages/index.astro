---
import Layout from "../layouts/Layout.astro";
import SiteGraph from "../components/SiteGraph.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { projectMeta } from "../data/projects";
import { buildSiteGraph } from "../lib/site_graph";

const featured = ["gitxnet", "chelicera", "envseal"] as const;

const graph = await buildSiteGraph();
const pageCount = graph.nodes.filter((n) => n.kind === "page").length;
---

<Layout title="Home">
  <section class="relative">
    <div class="relative z-10 mx-auto max-w-5xl px-6 pt-16 pb-4 lg:pt-28 lg:pb-28">
      <div class="lg:max-w-md">
        <h1
          class="font-display text-4xl sm:text-5xl font-semibold tracking-tight text-ink leading-[1.1]"
        >
          Backend &amp; infrastructure engineer.
        </h1>
        <p class="mt-6 text-muted leading-relaxed">
          I work on backend systems, automation, distributed applications and infrastructure —
          taking a problem apart, understanding it fully, and building the system from the ground
          up rather than bolting features onto something that already exists.
        </p>
        <p class="mt-3 text-muted leading-relaxed">
          Around 3 years of hands-on experience, covering personal, open-source and commercial work.
          Simplicity over cleverness, known patterns over reinvention, iterate until it actually
          holds up.
        </p>
        <div class="mt-8 flex flex-wrap gap-3">
          <a
            href="/development/projects"
            class="font-mono text-sm px-4 py-2 rounded-md bg-ink text-paper hover:bg-accent transition-colors"
          >
            view projects
          </a>
          <a
            href="/about/contact"
            class="font-mono text-sm px-4 py-2 rounded-md border border-hairline text-ink hover:border-accent hover:text-accent transition-colors"
          >
            get in touch
          </a>
        </div>
      </div>
    </div>

    <div
      class="h-[42vh] min-h-80 lg:h-auto lg:absolute lg:top-0 lg:bottom-0 lg:right-0 lg:w-[46%]"
    >
      <SiteGraph mode="ambient" class="w-full h-full" />
    </div>

    <div class="relative z-10 mx-auto max-w-5xl px-6 pt-4 lg:pt-0">
      <a
        href="/map"
        class="font-mono text-xs text-muted hover:text-accent transition-colors lg:absolute lg:bottom-8 lg:right-6"
      >
        every page on this site, {pageCount} of them — open the map →
      </a>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-6 pt-16 pb-24 lg:pt-24">
    <div class="flex items-baseline justify-between gap-4">
      <h2 class="font-mono text-xs uppercase tracking-wider text-muted">selected work</h2>
      <a
        href="/development/projects"
        class="font-mono text-xs text-muted hover:text-accent transition-colors"
      >
        all projects →
      </a>
    </div>

    <ul class="mt-4 border-t border-hairline">
      {
        featured.map((slug) => {
          const meta = projectMeta[slug];
          return (
            <li>
              <a
                href={`/development/projects/${slug}`}
                class="group grid grid-cols-1 sm:grid-cols-12 items-baseline gap-x-6 gap-y-2 border-b border-hairline py-5 transition-colors hover:bg-surface"
              >
                <h3 class="sm:col-span-3 font-display text-lg font-semibold text-ink transition-colors group-hover:text-accent">
                  {meta.title}
                </h3>
                <p class="sm:col-span-5 text-sm text-muted leading-relaxed">{meta.oneLiner}</p>
                <span class="sm:col-span-3 font-mono text-[11px] leading-relaxed text-muted">
                  {meta.stack.join(" · ")}
                </span>
                <span class="sm:col-span-1 sm:justify-self-end">
                  <StatusBadge status={meta.status} />
                </span>
              </a>
            </li>
          );
        })
      }
    </ul>
  </section>
</Layout>
